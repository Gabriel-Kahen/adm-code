int find_path(int start, int end, int parents[]) {
    if (end == -1) {
        printf("\nNo path");
        return 0;
    }
    if (start == end) {
        printf("\n%d", start);
    } else {
        if (!find_path(start, parents[end], parents))
            return 0;
        printf(" %d", end);
    }
    return 1;
}
