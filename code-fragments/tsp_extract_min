tsp_solution extract_min(priority_queue *q) {
    tsp_solution min; /* minimum value */

    if (q->n <= 0) {
        fputs("Cannot extract from an empty priority queue.\n", stderr);
        exit(EXIT_FAILURE);
    }

    min = q->q[1];

    q->q[1] = q->q[q->n];
    q->n = q->n - 1;
    bubble_down(q, 1);

    return (min);
}
