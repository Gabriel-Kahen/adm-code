/* Returns -1 with errno set for invalid arguments or an unrepresentable result. */
long binomial_coefficient(int n, int k) {
    long bc[MAXN+1] = {0};
    int i, j, last;

    errno = 0;
    if (n < 0 || n > MAXN || k < 0 || k > n) {
        errno = EDOM;
        return -1;
    }
    if (k > n-k) {
        k = n-k;
    }
    bc[0] = 1;
    for (i = 1; i <= n; i++) {
        last = i < k ? i : k;
        for (j = last; j > 0; j--) {
            if (bc[j] > LONG_MAX-bc[j-1]) {
                errno = ERANGE;
                return -1;
            }
            bc[j] += bc[j-1];
        }
    }
    return bc[k];
}
